#!/usr/bin/env bash
# Stub Azure CLI for script tests. Never contacts Azure.
# AZ_SCENARIO: clean | remaining | auth | auth-expired | permission | network | unexpected | garbage | partial-network
echo "az $*" >>"${STUB_LOG:?}"
scenario="${AZ_SCENARIO:-clean}"
args="$*"

not_found_rg() { echo "ERROR: (ResourceGroupNotFound) Resource group 'rg-atlas-foundation-dev' could not be found." >&2; echo "Code: ResourceGroupNotFound" >&2; exit 3; }
not_found_res() { echo "ERROR: (ResourceNotFound) The Resource '$1' under resource group 'rg-atlas-foundation-dev' was not found." >&2; echo "Code: ResourceNotFound" >&2; exit 3; }
auth_err() { echo "ERROR: Please run 'az login' to setup account." >&2; exit 1; }
expired_err() { echo "ERROR: AADSTS700082: The refresh token has expired due to inactivity. Please run 'az login'." >&2; exit 1; }
perm_err() { echo "ERROR: (AuthorizationFailed) The client 'user@example.com' with object id '00000000-0000-0000-0000-000000000000' does not have authorization to perform action 'Microsoft.Resources/subscriptions/resourcegroups/read'." >&2; exit 1; }
net_err() { echo "ERROR: HTTPSConnectionPool(host='management.azure.com', port=443): Max retries exceeded with url: /subscriptions (Caused by NewConnectionError('Failed to establish a new connection: [Errno -3] Temporary failure in name resolution'))" >&2; exit 1; }
odd_err() { echo "ERROR: (InternalServerError) Encountered internal server error." >&2; exit 1; }

case "${args}" in
  "vm run-command invoke"*)
    # RC_SCENARIO: ok | fail | outbound-mismatch | password-enabled | cloud-init-running | wrong-key | unhealthy
    rc="${RC_SCENARIO:-ok}"
    [[ "${rc}" == fail ]] && { echo "ERROR: (Conflict) Run command extension execution is in progress." >&2; exit 1; }
    ci="status: done"; [[ "${rc}" == cloud-init-running ]] && ci="status: running"
    health=healthy; [[ "${rc}" == unhealthy ]] && health=unhealthy
    pw=no; [[ "${rc}" == password-enabled ]] && pw=yes
    out=203.0.113.10; [[ "${rc}" == outbound-mismatch ]] && out=198.51.100.99
    fp="${STUB_KEY_FP:-SHA256:none}"; [[ "${rc}" == wrong-key ]] && fp="SHA256:someoneelse"
    printf 'Enable succeeded: \n[stdout]\nCLOUD_INIT=%s\nCONTAINER_HEALTH=%s\nLOCAL_HEALTH_CODE=200\nLOCAL_HEALTH_BODY={"status":"ok","service":"atlas-platform-foundation"}\nSSHD_permitrootlogin=no\nSSHD_pubkeyauthentication=yes\nSSHD_passwordauthentication=%s\nSSHD_kbdinteractiveauthentication=no\nAUTHORIZED_KEY_FPS=%s\nOUTBOUND_IP=%s\n\n[stderr]\n\n' "${ci}" "${health}" "${pw}" "${fp}" "${out}"
    exit 0 ;;
  "network nsg rule list"*)
    # NSG_SCENARIO: final | temp-present | error
    case "${NSG_SCENARIO:-final}" in
      error) perm_err ;;
    esac
    printf 'Allow-SSH-From-Admin\tAllow\t198.51.100.20/32\t\t22\nAllow-HTTP-From-Admin\tAllow\t198.51.100.20/32\t\t80\n'
    [[ "${NSG_SCENARIO:-final}" == temp-present ]] && printf 'Allow-SSH-HTTP-From-Test-Temporary\tAllow\t\t192.0.2.44/32,192.0.2.88/32\t\n'
    printf 'Deny-Internet-Inbound\tDeny\tInternet\t\t*\n'
    exit 0 ;;
  "account show"*)
    [[ "${scenario}" == auth ]] && auth_err
    echo "Example Subscription"; exit 0 ;;
  "group exists"*)
    case "${scenario}" in
      clean|partial-network) echo false ;;
      remaining) echo true ;;
      auth-expired) expired_err ;;
      permission) perm_err ;;
      network) net_err ;;
      unexpected) odd_err ;;
      garbage) echo "maybe" ;;
    esac
    exit 0 ;;
  "resource list"*)
    printf 'Name                      Type\n------------------------  ---------------------------------\npip-atlas-foundation-dev  Microsoft.Network/publicIPAddresses\n'
    exit 0 ;;
  "resource show"*)
    case "${scenario}" in
      clean|garbage) not_found_rg ;;
      remaining)
        if [[ "${args}" == *pip-atlas-foundation-dev* ]]; then echo '{"name":"pip-atlas-foundation-dev"}'; exit 0; fi
        not_found_res "${args##* }" ;;
      partial-network)
        [[ "${args}" == *nic-atlas-foundation-dev* ]] && net_err
        not_found_rg ;;
      auth-expired) expired_err ;;
      permission) perm_err ;;
      network) net_err ;;
      unexpected) odd_err ;;
    esac ;;
esac
echo "stub az: unhandled command: ${args}" >&2
exit 99
