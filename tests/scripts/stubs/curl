#!/usr/bin/env bash
# Stub curl for script tests.
# CURL_SCENARIO: ok | health-500 | health-badbody | root-badbody | timeout | timeout-curl8 |
#                op-timeout | refused | unreachable | badopt
# CURL_CONTROL:  ok | fail   (the https://api.ipify.org / ifconfig.me lookup)
echo "curl $*" >>"${STUB_LOG:?}"
out="" url=""
while (( $# )); do
  case "$1" in
    -o) out="$2"; shift ;;
    http*://*) url="$1" ;;
  esac
  shift
done
if [[ "${url}" == *ifconfig.me* || "${url}" == *api.ipify.org* ]]; then
  [[ "${CURL_CONTROL:-ok}" == fail ]] && { echo "curl: (6) Could not resolve host: api.ipify.org" >&2; exit 6; }
  printf '198.51.100.7'; exit 0
fi
scenario="${CURL_SCENARIO:-ok}"
case "${scenario}" in
  timeout) echo "curl: (28) Connection timed out after 10001 milliseconds" >&2; printf '000'; exit 28 ;;
  timeout-curl8) echo "curl: (28) Failed to connect to 203.0.113.10 port 80 after 1002 ms: Timeout was reached" >&2; printf '000'; exit 28 ;;
  op-timeout) echo "curl: (28) Operation timed out after 1001 milliseconds with 0 bytes received" >&2; printf '000'; exit 28 ;;
  refused) echo "curl: (7) Failed to connect to 203.0.113.10 port 80: Connection refused" >&2; printf '000'; exit 7 ;;
  unreachable) echo "curl: (7) Failed to connect to 203.0.113.10 port 80: Network is unreachable" >&2; printf '000'; exit 7 ;;
  badopt) echo "curl: option --connect-timeout: is unknown" >&2; echo "curl: try 'curl --help' for more information" >&2; exit 2 ;;
esac
code=200
case "${url}" in
  */health)
    body='{"status":"ok","service":"atlas-platform-foundation"}'
    [[ "${scenario}" == health-500 ]] && { code=500; body='<html>500 Internal Server Error</html>'; }
    [[ "${scenario}" == health-badbody ]] && body='{"status":"starting"}' ;;
  *)
    body='<h1>Atlas Platform Foundation</h1>'
    [[ "${scenario}" == root-badbody ]] && body='<h1>Welcome to nginx!</h1>' ;;
esac
if [[ -n "${out}" ]]; then printf '%s' "${body}" >"${out}"; else printf '%s' "${body}"; fi
printf '%s' "${code}"
