  {"address":"module.compute.azurerm_linux_virtual_machine.this","change":{"actions":["create"],"after":{"custom_data":"I2Nsb3VkLWNvbmZpZw==","admin_ssh_key":[{"public_key":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKAhnnlI7ScyqxeIK1AysQ0aqybx6fYKZbROGFSh78TQ"}]}}},
